---
// Timeline.astro — Roman Numeral Chapter Cards with Logbook Overlay
const weeks = [
  {
    roman:  'I',
    range:  '13 — 19 Juli 2026',
    badge:  { label: 'Minggu 01', type: 'badge-crimson' },
    image:  '/assets/images/week1.png',
    imageAlt: 'Minggu pertama – Kedatangan & Orientasi',
    title:  'Kedatangan & Orientasi',
    desc:   'Tiba di Desa Angsana, disambut aparat desa dan tokoh masyarakat. Melakukan koordinasi awal, perkenalan program kerja, serta mulai beradaptasi dengan lingkungan dan budaya masyarakat setempat.',
    tags:   ['Koordinasi', 'Orientasi', 'Adaptasi'],
    days: [
      { date: '13 Juli 2026', dayName: 'Minggu', activities: ['Koordinasi dengan Kepala Desa'] },
      { date: '14 Juli 2026', dayName: 'Senin', activities: ['Kunjungan Kepala Kecamatan Angsana ke Posko KKN'] },
