---
// About.astro — Two-Column Journal Layout & Team Carousel
const stats = [
  { num: 16, suffix: '',       label: 'Anggota Tim' },
  { num: 1,  suffix: ' bulan', label: 'Durasi KKN'  },
  { num: 5,  suffix: '',       label: 'Program Kerja'},
];

const teamMembers = [
  { id: 1,  name: 'Ahmad Ryan Faizal',       role: 'Koordinator Desa',     image: '/assets/images/members/Ahmad Ryan Faizal.JPG',        pos: 'center 45%' },
  { id: 2,  name: 'Cindy Meiliawan',          role: 'Sekretaris',            image: '/assets/images/members/Cindy Meiliawan.jpg',           pos: 'center 50%' },
  { id: 3,  name: 'Tania Yuanda',             role: 'Sekretaris',            image: '/assets/images/members/Tania Yuanda.jpeg',            pos: 'center 65%' },
  { id: 4,  name: 'Nur Zahwa',                role: 'Bendahara',             image: '/assets/images/members/Nur Zahwa.jpg',                 pos: 'center 60%' },
  { id: 5,  name: 'Muhammad Syarif',          role: 'Koordinator Acara',     image: '/assets/images/members/Muhammad Syarif.JPG',         pos: 'center 50%' },
  { id: 6,  name: 'Kezia Atalia Samosir',     role: 'Acara',                 image: '/assets/images/members/Kezia Atalia Samosir.jpg',      pos: 'center 75%' },
  { id: 7,  name: 'Anes',                     role: 'Acara',                 image: '/assets/images/members/Anes.jpg',                     pos: 'center 65%' },
  { id: 8,  name: 'Hamdi Fansuri',            role: 'Koordinator Humas',     image: '/assets/images/members/Hamdi Fansuri.JPG',            pos: 'center 45%' },
  { id: 9,  name: 'Wahid Nor Raihan',         role: 'Koordinator PDD',       image: '/assets/images/members/Wahid Nor Raihan.JPG',          pos: 'center 45%' },
  { id: 10, name: 'Irfi Yusroini Pribadi',    role: 'PDD',                   image: '/assets/images/members/Irfi Yusroini Pribadi.JPG',     pos: 'center 75%' },
  { id: 11, name: 'Andini Prasetya N.',       role: 'PDD',                   image: '/assets/images/members/Andini Prasetya N.jpeg',        pos: 'center 88%' },
  { id: 12, name: 'Dakin Gultom',             role: 'Koordinator Logistik',  image: '/assets/images/members/Dakin Gultom.jpg',             pos: 'center 78%' },
  { id: 13, name: 'Candra Permana',           role: 'Logistik',              image: '/assets/images/members/Candra Permana.JPG',           pos: 'center 75%' },
  { id: 14, name: 'Meita Amelia Putri',       role: 'Logistik',              image: '/assets/images/members/Meita Amelia Putri.jpg',       pos: 'center 85%' },
  { id: 15, name: 'Laili Maulida',            role: 'Koordinator Konsumsi',  image: '/assets/images/members/Laili Maulida.jpg',            pos: 'center 60%' },
  { id: 16, name: 'Rahdatia Silva',           role: 'Konsumsi',              image: '/assets/images/members/Rahdatia Silva.JPG',           pos: 'center 60%' },
];
---

<section id="about" aria-label="Tentang KKN">
  <div class="container">

    <!-- Ornamental top rule -->
    <div class="ornament-rule reveal">❧</div>

    <div class="about-grid">

      <!-- Left: Vintage photo frame -->
      <div class="about-image-wrap reveal-left reveal">
        <div class="about-image-container">
          <span class="corner-orn tl"></span>
          <span class="corner-orn tr"></span>
          <span class="corner-orn bl"></span>
          <span class="corner-orn br"></span>
          <img
            src="/assets/images/foto-kkn-02.jpg"
            alt="Tim KKN Kelompok 2 ULM di Desa Angsana"
            class="about-image"
            loading="lazy"
          />
        </div>
        <p class="about-photo-caption">Tim KKN Kelompok 2 — Desa Angsana, Juli 2026</p>

        <!-- Wax seal stamp -->
        <div class="about-wax-stamp stamp-anim" aria-hidden="true">
          <div class="wax-seal">
            KKN<br>2026
          </div>
        </div>
      </div>

      <!-- Right: Journal text content -->
      <div class="about-content">
        <div class="reveal">
          <p class="chapter-eyebrow">
            <span class="orn">❧</span>
            Bab I — Tentang Kami
          </p>
          <h2 class="section-heading">
            Bukan Sekadar<br>
            <em>Program Kuliah</em>
          </h2>
        </div>

        <p class="about-text drop-cap reveal delay-2">
          KKN bukan hanya kewajiban akademik — ini adalah perjalanan dan dedikasi.
          Selama 1 bulan (13 Juli – 10 Agustus 2026), Kelompok 02 Universitas Lambung Mangkurat
          hidup berdampingan dengan warga Desa Angsana. Bersama masyarakat pesisir, kami
          mewujudkan aksi nyata melalui program pengelolaan sampah TPS3R, inovasi pupuk organik
          POC &amp; Ecoenzym, pelestarian ekowisata mangrove, digitalisasi UMKM olahan perikanan,
          serta gotong royong kemasyarakatan.
        </p>

        <!-- Pull quote -->
        <div class="about-quote-block reveal delay-3">
          <p>
            "Terinspirasi oleh filosofi Pohon Angsana — kokoh membumi,
            meneduhkan, menebar kebaikan — kami hadir untuk belajar dan
            berbagi bersama."
          </p>
        </div>

        <!-- Stats as field data -->
        <div class="about-stats reveal delay-4">
          {stats.map(s => (
            <div class="about-stat">
              <div class="about-stat-num">
                <span data-count={s.num} data-suffix={s.suffix}>0</span>
              </div>
              <div class="about-stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- ═══════════════════════════════════════
         16 TEAM MEMBERS CAROUSEL
    ═══════════════════════════════════════ -->
    <div class="team-section reveal">
      <div class="team-header">
        <h3 class="team-title">
          <span class="orn">❧</span> 16 Anggota Tim Pengabdi
        </h3>
        <p class="team-hint">Geser untuk melihat seluruh anggota tim</p>
      </div>

      <div class="team-carousel-container">
        <div class="team-carousel-track">
          {teamMembers.map((m) => (
            <div class="team-card">
              <div class="team-card-image-wrap">
                <img
                  src={m.image}
                  alt={m.name}
                  class="team-card-img"
                  style={m.pos ? `--pos:${m.pos};` : undefined}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
                <span class="team-card-id">#{String(m.id).padStart(2, '0')}</span>
              </div>
              <div class="team-card-info">
                <h4 class="team-card-name">{m.name}</h4>
                <p class="team-card-role">{m.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom ornamental rule -->
    <div class="ornament-rule reveal">❧</div>
  </div>
</section>
