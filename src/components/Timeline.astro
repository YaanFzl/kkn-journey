      { date: '25 Juli 2026', dayName: 'Jumat', activities: ['Koordinasi dengan Pak Nuh selaku teman–teman dari Hijau Lestari untuk melakukan survey kawasan mangrove untuk berlangsungnya program kerja pembuatan kopi mangrove'] },
      { date: '26 Juli 2026', dayName: 'Sabtu', activities: [
