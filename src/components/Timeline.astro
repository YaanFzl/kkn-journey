        phase: 'Fase III — Pelepasan & Pamitan Resmi',
        dateRange: '10 Agustus 2026',
        dayName: 'Senin',
        activities: [
          'Penyerahan laporan resmi KKN dan kenang-kenangan kepada Kepala Desa Angsana & Perangkat Desa',
          'Pelepasan mahasiswa KKN Kelompok 2 Universitas Lambung Mangkurat',
        ],
        photoLinked: false,
      },
    ],
  },
];

// Dates that have photos in Bab 3 Gallery
const galleryDates = ['13 Juli 2026','21 Juli 2026','25 Juli 2026','28 Juli 2026','14 Agustus 2026'];
---

<section id="timeline" aria-label="Timeline Perjalanan KKN">
  <div class="container">

    <!-- Header -->
    <div class="timeline-header reveal">
      <p class="chapter-eyebrow" style="justify-content:center;">
        <span class="orn">❧</span>
        Bab II — Kronik Perjalanan
      </p>
      <h2 class="section-heading" style="text-align:center;">
        Empat Minggu,<br>
        <em>Empat Bab Cerita</em>
      </h2>
      <p style="color:var(--ink-500); max-width:520px; margin:var(--sp-4) auto 0; text-align:center; font-size:var(--fs-sm); font-style:italic;">
        Setiap minggu menyimpan ceritanya sendiri — tantangan, keberhasilan,
        dan kenangan yang tak terhapus waktu.
      </p>
    </div>

    <!-- Four chapter cards -->
    <div class="weeks-container">
      {weeks.map((w, i) => (
        <div class={`week-card glass-card reveal delay-${i + 1}`}>
          <!-- Chapter strip header -->
          <div class="week-header-strip">
            <span class="week-roman">{w.roman}</span>
            <span class="week-number">{w.range}</span>
          </div>

          <!-- Photo -->
          <div class="week-img-wrap">
            <img src={w.image} alt={w.imageAlt} class="week-img" loading="lazy" />
            <div class="week-img-overlay"></div>
            <div class="week-img-badge">
              <span class={`badge ${w.badge.type}`}>{w.badge.label}</span>
            </div>
          </div>

          <!-- Text -->
          <div class="week-content">
            <h3 class="week-title">{w.title}</h3>
            <p class="week-desc">{w.desc}</p>
            <div class="week-tags">
              {w.tags.map(tag => (
                <span class="week-tag">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Open logbook overlay button -->
          <button class="btn-open-logbook" data-week={String(i)} type="button">
            <span class="btn-open-logbook-text">📖 Buka Logbook</span>
            <span class="btn-open-logbook-arrow">→</span>
          </button>
        </div>
      ))}
    </div>

    <div class="ornament-rule reveal">❧</div>
  </div>

  <!-- ═══════════════════════════════════════════
       LOGBOOK OVERLAY — Full-screen Journal Page
       ═══════════════════════════════════════════ -->
  <div id="logbook-overlay" role="dialog" aria-modal="true" aria-label="Logbook Harian" aria-hidden="true">
    <!-- Backdrop -->
    <div class="logbook-backdrop"></div>

    <!-- Close button -->
    <button id="logbook-close" aria-label="Tutup logbook">✕</button>

    <!-- Journal page container -->
    <div class="logbook-journal">
      <!-- Journal header (populated by JS with week data) -->
      <div class="logbook-journal-header">
        <div class="logbook-journal-roman" id="logbook-roman">I</div>
        <div class="logbook-journal-meta">
          <h3 class="logbook-journal-title" id="logbook-title">Kedatangan & Orientasi</h3>
          <p class="logbook-journal-range" id="logbook-range">13 — 19 Juli 2026</p>
        </div>
      </div>

      <div class="logbook-journal-divider"></div>

      <!-- Scrollable content -->
      <div class="logbook-journal-scroll">
        {weeks.map((w, wIdx) => (
          <div class="logbook-week-content" data-week-content={String(wIdx)}>
            {w.isFinale ? (
              /* Special Grand Finale Layout for Page 4 (Minggu IV) */
              <div class="logbook-finale-container">
                <div class="logbook-finale-badge">
                  <span class="orn">❧</span> Bab Puncak & Epilog Pengabdian
                </div>

                {w.phases?.map((p, pIdx) => (
                  <div class={`logbook-finale-card ${p.photoLinked ? 'featured' : ''}`}>
                    <div class="logbook-finale-card-header">
                      <span class="logbook-finale-phase">{p.phase}</span>
                      <span class="logbook-finale-date">📅 {p.dateRange}</span>
                    </div>
                    <ul class="logbook-activities">
                      {p.activities.map(act => (
                        <li class="logbook-activity-item">{act}</li>
                      ))}
                    </ul>
                    <div class="logbook-entry-photo">
                      {p.photoLinked ? (
                        <button class="btn-view-gallery" data-gallery-date={p.galleryDate} type="button">
                          🖼️ Lihat Foto Malam Perpisahan di Galeri ↗
                        </button>
                      ) : (
                        <span class="logbook-photo-empty">📷 Foto belum tersedia</span>
                      )}
                    </div>
                  </div>
                ))}

                <!-- Wax Seal Epilogue Card -->
                <div class="logbook-epilogue-card">
                  <div class="wax-seal-mini">KKN 02</div>
                  <div class="logbook-epilogue-text">
                    <p class="epilogue-quote">
                      "Satu bulan mengabdi, seumur hidup menginspirasi. Terima kasih Desa Angsana telah menjadi rumah kedua kami."
                    </p>
                    <p class="epilogue-signature">
                      — Tim KKN Kelompok 2 Universitas Lambung Mangkurat (2026)
                    </p>
                  </div>
                  <a href="#gallery" class="btn-epilogue-link" id="btn-epilogue-gallery">
                    🎞️ Lihat Galeri Foto Lapangan (Bab III) ↗
                  </a>
                </div>
              </div>
            ) : (
              /* Standard Daily Logbook Layout for Weeks I, II, III */
              w.days?.map((day, dIdx) => (
                <div class="logbook-entry">
                  <div class="logbook-entry-date">
                    <span class="logbook-entry-num">{String(dIdx + 1).padStart(2, '0')}</span>
                    <div class="logbook-entry-date-info">
                      <span class="logbook-entry-date-text">{day.date}</span>
                      <span class="logbook-entry-day-name">{day.dayName}</span>
                    </div>
                  </div>
                  <div class="logbook-entry-body">
                    {day.activities.map(act => (
                      <p class="logbook-entry-activity">{act}</p>
                    ))}
                    <div class="logbook-entry-photo">
                      {galleryDates.includes(day.date) ? (
                        <button class="btn-view-gallery" data-gallery-date={day.date} type="button">
                          🖼️ Lihat di Galeri ↗
                        </button>
                      ) : (
                        <span class="logbook-photo-empty">📷 Foto belum tersedia</span>
                      )}
                    </div>
                  </div>
                </div>
              ))
            )}
          </div>
        ))}
      </div>

      <!-- Footer navigation -->
      <div class="logbook-journal-footer">
        <button id="logbook-prev" class="logbook-nav-btn" type="button">
          <span class="logbook-nav-arrow">‹</span>
          <span class="logbook-nav-label" id="logbook-prev-label">Minggu I</span>
        </button>
        <div class="logbook-page-indicator">
          <span id="logbook-page-current">1</span>
          <span class="logbook-page-sep">/</span>
          <span>4</span>
        </div>
        <button id="logbook-next" class="logbook-nav-btn" type="button">
          <span class="logbook-nav-label" id="logbook-next-label">Minggu II</span>
          <span class="logbook-nav-arrow">›</span>
        </button>
      </div>
    </div>
  </div>
</section>
