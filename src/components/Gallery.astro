---
// Gallery.astro — Wanda.net-style Floating Photo Canvas
const photos = [
  {
    src:         '/assets/images/week1.png',
    alt:         'Kedatangan Tim KKN Kelompok 2',
    title:       'Langkah Pertama Mengabdi',
    day:         '13 Juli 2026',
    category:    'Kedatangan',
    location:    'Kantor Desa Angsana',
    description: 'Hari pertama KKN dimulai dengan penuh harap saat kami tiba di Desa Angsana. Disambut hangat aparat desa dan tokoh masyarakat, kami langsung memetakan wilayah pesisir dan mendiskusikan program kerja sebulan ke depan bersama kelompok nelayan setempat.',
    // Position on the canvas (% of canvas): [left%, top%]
    pos:  [8,  12],
    size: [340, 240],
    rot:  -3.5,
    depth: 0.7,
  },
  {
    src:         '/assets/images/week2.png',
    alt:         'Kelas literasi anak-anak nelayan',
    title:       'Pilar Masa Depan Pesisir',
    day:         '21 Juli 2026',
    category:    'Edukasi',
    location:    'Posko KKN & Pantai Angsana',
    description: 'Anak-anak nelayan berkumpul penuh antusias mengikuti kelas literasi pesisir dan bimbingan belajar. Di bawah rindangnya pepohonan dekat pantai, kami belajar bersama tentang sains dasar, membaca, dan kepedulian terhadap laut dan lingkungan.',
    pos:  [52, 5],
    size: [300, 220],
    rot:  2.8,
    depth: 1.1,
  },
  {
    src:         '/assets/images/week3.png',
    alt:         'Transplantasi karang di perairan Angsana',
    title:       'Menanam Harapan di Dasar Laut',
    day:         '2 Agustus 2026',
    category:    'Konservasi',
    location:    'Perairan Pantai Angsana',
    description: 'Bekerja sama dengan kelompok sadar wisata nelayan lokal, kami turun ke laut melakukan transplantasi karang menggunakan media meja besi. Program ini bertujuan memulihkan terumbu karang yang rusak dan menjaga keanekaragaman hayati bawah laut Kalimantan Selatan.',
    pos:  [28, 42],
    size: [380, 260],
    rot:  1.2,
    depth: 0.9,
  },
  {
    src:         '/assets/images/hero.png',
    alt:         'Keindahan pesisir Pantai Angsana',
    title:       'Ketenangan Pantai Angsana',
    day:         '25 Juli 2026',
    category:    'Refleksi',
    location:    'Pantai Angsana',
    description: 'Menikmati senja keemasan setelah seharian mengabdi di desa. Pantai Angsana dengan ombaknya yang tenang menjadi pengingat berharga akan kedamaian dan kehangatan yang diberikan alam pesisir serta ketulusan hati masyarakat nelayan desa ini.',
    pos:  [68, 38],
    size: [310, 200],
    rot:  -2.0,
    depth: 1.3,
  },
  {
    src:         '/assets/images/week4.png',
    alt:         'Malam perpisahan bersama warga desa',
    title:       'Ikatan yang Abadi',
    day:         '9 Agustus 2026',
    category:    'Seremoni',
    location:    'Balai Desa Angsana',
    description: 'Malam keakraban penuh haru bersama seluruh masyarakat Desa Angsana. Kami menyajikan pentas seni kecil sebagai tanda pamit dan terima kasih atas kehangatan yang menjadikan desa nelayan ini seperti rumah kedua bagi setiap anggota kelompok kami.',
    pos:  [12, 62],
    size: [360, 240],
    rot:  3.5,
    depth: 1.0,
  },
  {
    src:         '/assets/images/week2.png',
    alt:         'Pelatihan UMKM produk olahan ikan',
    title:       'Mandiri Ekonomi Pesisir',
    day:         '28 Juli 2026',
    category:    'UMKM',
    location:    'Balai Pertemuan Nelayan',
    description: 'Pelatihan pembuatan kerupuk dan abon ikan bersama ibu-ibu PKK Desa Angsana. Kami membantu mendesain kemasan baru yang lebih menarik serta mengajarkan dasar-dasar pemasaran digital agar produk lokal hasil laut bisa menjangkau pasar yang lebih luas.',
    pos:  [55, 62],
    size: [320, 210],
    rot:  -1.8,
    depth: 0.8,
  },
];
---

<section id="gallery" aria-label="Galeri Foto KKN — Bab III">

  <!-- Section header -->
  <div class="container">
    <div class="gallery-header reveal">
      <div>
        <p class="chapter-eyebrow">
          <span class="orn">❧</span>
          Bab III — Foto Lapangan
        </p>
        <h2 class="section-heading">
          Momen yang<br>
          <em>Berbicara</em>
        </h2>
      </div>
      <p class="gallery-hint">
        <span class="hint-desktop">Gerakkan kursor untuk menjelajah.<br>Klik foto untuk membuka momen.</span>
        <span class="hint-mobile">Geser untuk menjelajah.<br>Ketuk foto untuk membuka.</span>
      </p>
    </div>
  </div>

  <!-- Floating canvas container -->
  <div id="gallery-float-wrapper">
    <!-- Cursor hint icon -->
    <div class="gallery-cursor-hint" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
        <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.4"/>
        <circle cx="24" cy="24" r="4" fill="currentColor" opacity="0.6"/>
        <path d="M24 10 L24 4 M24 44 L24 38 M10 24 L4 24 M44 24 L38 24" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.35"/>
      </svg>
      <span class="hint-desktop">Jelajahi</span>
      <span class="hint-mobile">Geser & Ketuk</span>
    </div>

    <!-- The floating canvas — all photos live here -->
    <div id="gallery-float-canvas">
      {photos.map((photo, i) => (
        <div
          class="float-photo"
          data-title={photo.title}
          data-day={photo.day}
          data-category={photo.category}
          data-location={photo.location}
          data-description={photo.description}
          data-depth={String(photo.depth)}
          role="button"
          tabindex="0"
          aria-label={`Buka foto: ${photo.title}`}
          style={`
            left: ${photo.pos[0]}%;
            top:  ${photo.pos[1]}%;
            width: ${photo.size[0]}px;
            --rot: ${photo.rot}deg;
            --delay: ${i * 0.12}s;
          `}
        >
          <!-- Polaroid-style frame -->
          <div class="float-photo-frame">
            <img
              src={photo.src}
              alt={photo.alt}
              class="float-photo-img"
              loading="lazy"
              draggable="false"
            />
          </div>
          <p class="float-photo-caption">{photo.title}</p>
        </div>
      ))}
    </div>

    <!-- Vignette edges -->
    <div class="gallery-vignette" aria-hidden="true"></div>
  </div>


  <!-- ═══════════════════════════════════════════
       PHOTO POPUP — Click to open full detail
       ═══════════════════════════════════════════ -->
  <div id="float-popup" role="dialog" aria-modal="true" aria-label="Detail Foto" style="display:none;">
    <button id="float-popup-close" aria-label="Tutup">✕</button>

    <div class="float-popup-inner">
      <!-- Image pane -->
      <div class="float-popup-img-pane">
        <img id="float-popup-img" src="" alt="" />
        <!-- Corner frames -->
        <span class="popup-corner popup-corner-tl"></span>
        <span class="popup-corner popup-corner-tr"></span>
        <span class="popup-corner popup-corner-bl"></span>
        <span class="popup-corner popup-corner-br"></span>
      </div>

      <!-- Info pane -->
      <div class="float-popup-info">
        <div class="float-popup-badges">
          <span id="float-popup-day" class="badge badge-crimson"></span>
          <span id="float-popup-cat" class="badge badge-gold"></span>
        </div>
        <h3 id="float-popup-title"></h3>
        <p id="float-popup-loc" class="float-popup-loc"></p>
        <div class="float-popup-rule"></div>
        <p id="float-popup-desc" class="float-popup-desc"></p>
      </div>
    </div>
  </div>

</section>
